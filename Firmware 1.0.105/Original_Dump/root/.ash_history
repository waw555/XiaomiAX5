дls -l
ls -l
cd /
ls -l
cat /proc/mtd
mkdir -p /tmp/dump
for i in /dev/mtd*; do
    name=$(grep $(basename $i) /proc/mtd | cut -d\" -f2)
    echo "Dumping $i ($name)"
    dd if=$i of=/tmp/dump/$name.bin
done
